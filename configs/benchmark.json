  "external_tools": {
    "playcanvas-compressed": {
      "encode": ["splat-transform", "{in}", "{out}"], "decode": ["splat-transform", "{out}", "{back}"],
      "ext": ".compressed.ply", "install": "npm install -g @playcanvas/splat-transform"
    },
    "playcanvas-sog": {
      "encode": ["splat-transform", "{in}", "{out}"], "decode": ["splat-transform", "{out}", "{back}"],
      "ext": ".sog", "install": "npm install -g @playcanvas/splat-transform"
    }
  },
