{
 "description": "Suite pour une VRAIE capture : élagage « views » scoré sur les poses réelles des photos (hors vues de test), vues de test = photos réelles. Nécessite data/<scène>_cameras.json (train_3dgs.py). Référence = modèle original ; familles appliquées après un nettoyage léger (le nettoyage moyen retire des murs sur une vraie scène).",
 "reference_label": "modèle original (une vraie capture n a pas de vérité sans défauts)",
 "reference": [],
 "external_tools": {
  "playcanvas-compressed": {
   "encode": [
    "splat-transform",
    "{in}",
    "{out}"
   ],
   "decode": [
    "splat-transform",
    "{out}",
    "{back}"
   ],
   "ext": ".compressed.ply",
   "install": "npm install -g @playcanvas/splat-transform"
  },
  "playcanvas-sog": {
   "encode": [
    "splat-transform",
    "{in}",
    "{out}"
   ],
   "decode": [
    "splat-transform",
    "{out}",
    "{back}"
   ],
   "ext": ".sog",
   "install": "npm install -g @playcanvas/splat-transform"
  }
 },
